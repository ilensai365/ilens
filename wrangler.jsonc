{
  "name": "ilens",
  "compatibility_date": "2026-09-14",
  // Worker: /api/chat (AI assistant). Everything else is served from the static assets below.
  // Secret needed for the chat: ANTHROPIC_API_KEY (set in the Cloudflare dashboard, never in this repo).
  "main": "worker/index.js",
  "assets": {
    // Built React site (cd site-v2 && npm run build). Old static site stays in the repo root for rollback.
    "directory": "./site-v2/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
